# tsubame-lumerical-setup test model: one TiO2-like pillar (n 2.3, r 80 nm, h 1.3 um) in a 250 nm
# periodic cell on glass (n 1.457), plane wave at 630 nm from above, mesh 10 nm. Saved as cell.fsp.
newproject;
P = 250e-9; H = 1.3e-6; r = 80e-9;
addfdtd; set("x",0); set("y",0); set("x span",P); set("y span",P); set("z min",-1e-6); set("z max",H+1e-6);
set("x min bc","Periodic"); set("y min bc","Periodic"); set("mesh accuracy",2); set("simulation time",1000e-15);
addrect; set("name","sub"); set("x",0); set("y",0); set("x span",2*P); set("y span",2*P); set("z min",-3e-6); set("z max",0);
set("material","<Object defined dielectric>"); set("index",1.457);
addcircle; set("name","pillar"); set("x",0); set("y",0); set("radius",r); set("z min",0); set("z max",H);
set("material","<Object defined dielectric>"); set("index",2.3);
addmesh; set("name","mesh"); set("x",0); set("y",0); set("x span",P); set("y span",P); set("z min",-0.1e-6); set("z max",H+0.1e-6);
set("dx",10e-9); set("dy",10e-9); set("dz",20e-9);
addplane; set("name","source"); set("injection axis","z"); set("direction","Backward"); set("x",0); set("y",0);
set("x span",2*P); set("y span",2*P); set("z",H+0.6e-6); set("wavelength start",630e-9); set("wavelength stop",630e-9);
addpower; set("name","T"); set("monitor type","2D Z-normal"); set("x",0); set("y",0); set("x span",P); set("y span",P); set("z",-0.6e-6);
setglobalmonitor("frequency points",1);
save("cell.fsp");
